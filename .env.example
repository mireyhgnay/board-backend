# ════════════════════════════════════════════════════════════════
# 📌 .env.example - 환경 변수 예시 파일
#
# 【 사용 방법 】
#     이 파일을 복사해서 .env 파일을 만드세요:
#         cp .env.example .env
#
#     그리고 .env 파일의 값들을 실제 값으로 변경하세요.
#
# 【 주의사항 】
#     - .env 파일은 절대 git에 올리지 마세요! (.gitignore에 추가됨)
#     - 이 파일(.env.example)은 git에 올려도 됩니다. (값이 없으니까요)
#     - 팀원이 새로 참여하면 이 파일을 보고 .env를 만들 수 있습니다.
# ════════════════════════════════════════════════════════════════

# ──────────────────────────────────────
# 🔧 앱 설정
# ──────────────────────────────────────
APP_NAME=Board Backend
APP_VERSION=0.1.0
# 개발 환경: True (SQL 쿼리 로그 출력) / 운영 환경: False
DEBUG=True

# ──────────────────────────────────────
# 🗄️ Supabase 데이터베이스 설정
#
# Supabase URL 가져오는 방법:
#   1. https://supabase.com → 프로젝트 생성 (무료)
#   2. 프로젝트 대시보드 → 좌측 메뉴 Settings → Database
#   3. "Connection string" 섹션 → "URI" 탭 클릭
#   4. 비밀번호 부분([YOUR-PASSWORD])을 실제 비밀번호로 교체 후 복사
#
# 로컬 개발용 (Direct connection, 포트 5432):
#   postgresql://postgres:[비밀번호]@db.[프로젝트ID].supabase.co:5432/postgres
#
# 클라우드 배포용 (Connection pooler, 포트 6543):
#   postgresql://postgres.[프로젝트ID]:[비밀번호]@aws-0-[리전].pooler.supabase.com:6543/postgres
# ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# ──────────────────────────────────────
# 🌐 CORS 설정
# ──────────────────────────────────────
# Vercel 배포 URL을 추가하세요. 리스트 형식(JSON)으로 작성합니다.
# 로컬 개발 URL은 config.py에 기본값으로 이미 포함되어 있습니다.
# ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","https://your-project.vercel.app"]
